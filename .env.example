# Koneksi PostgreSQL.
# Supabase: buka project → tombol Connect → tab ORMs → Prisma, salin DATABASE_URL dan DIRECT_URL.
# Lokal: keduanya boleh sama.
DATABASE_URL="postgresql://malewa:malewa@localhost:5432/malewa"
DIRECT_URL="postgresql://malewa:malewa@localhost:5432/malewa"
# Rahasia untuk tanda tangan sesi login (string acak panjang, min. 32 karakter)
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"
# Upload foto produk saat online (pilih salah satu):
# - Supabase Storage: Project Settings → API → Project URL & service_role key (rahasia, jangan dibagikan)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# - atau Vercel Blob
BLOB_READ_WRITE_TOKEN=""
# Kalau semuanya kosong, foto disimpan di folder uploads-local/ (hanya untuk lokal).
# Akun admin awal yang dibuat oleh seed
SEED_ADMIN_EMAIL="admin@malewa.com"
SEED_ADMIN_PASSWORD="ganti-password-ini"
