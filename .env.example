# Koneksi PostgreSQL. Lokal contoh:
DATABASE_URL="postgresql://malewa:malewa@localhost:5432/malewa"
# Rahasia untuk tanda tangan sesi login (string acak panjang, min. 32 karakter)
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"
# Opsional: token Vercel Blob untuk upload foto produk saat online.
# Kalau kosong, foto disimpan di public/uploads (hanya untuk lokal).
BLOB_READ_WRITE_TOKEN=""
# Akun admin awal yang dibuat oleh seed
SEED_ADMIN_EMAIL="admin@malewa.com"
SEED_ADMIN_PASSWORD="ganti-password-ini"
